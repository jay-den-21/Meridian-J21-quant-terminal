# Copy to .env and fill in local secrets. Do not commit real values.
FDP_ENV=local
FDP_DB_DRIVER=mysql+pymysql
# Optional: set FDP_DATABASE_URL instead of the individual FDP_DB_* values.
FDP_DATABASE_URL=
FDP_DB_HOST=localhost
FDP_DB_PORT=3306
FDP_DB_USER=
FDP_DB_PASSWORD=
FDP_DB_NAME=
EODHD_API_KEY=

# Optional EODHD runtime controls. Defaults live in config/default.yaml.
EODHD_MAX_RETRIES=5
EODHD_RETRY_DELAY_SECONDS=61
EODHD_MAX_REQUESTS_PER_MINUTE=600
EODHD_DAILY_CALL_BUDGET=100000
EODHD_DAILY_RANGE_PARALLEL=false
EODHD_DAILY_RANGE_MAX_WORKERS=4
